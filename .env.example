# API Keys (REQUIRED)
GROQ_API_KEY=your_groq_key_here
OPENROUTER_API_KEY=your_openrouter_key_here
GEMINI_API_KEY=your_gemini_key_here

# AngelOne (REQUIRED for NSE data)
ANGEL_API_KEY=your_angel_key
ANGEL_CLIENT_ID=your_client_id
ANGEL_PASSWORD=your_password
ANGEL_TOTP_SECRET=your_totp_secret

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Security
API_KEY=change-this-in-production
CORS_ORIGINS=http://localhost:3000,http://168.144.64.203

# Trading Parameters
VIX_THRESHOLD=18.0
CONFIDENCE_THRESHOLD_BUY_SELL=65
CONFIDENCE_THRESHOLD_HOLD=85
PRICE_UPDATE_INTERVAL=5

# Logging
LOG_LEVEL=INFO
LOG_DIR=/opt/share-market/logs

# Database
DATABASE_URL=sqlite:///trading_signals.db

# Token Limits
GROQ_DAILY_LIMIT=500000
GEMINI_DAILY_LIMIT=1000000
